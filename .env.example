# Copy this file to .env for local development (vercel dev will load it).
# NEVER commit the real .env file — it is already listed in .gitignore.
# In production, set these as encrypted Environment Variables in your
# hosting provider's dashboard (Vercel: Project → Settings → Environment
# Variables), not in any file that gets committed.

# Razorpay API keys — Dashboard → Settings → API Keys
# https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID is safe to expose to the browser (the API returns it to
# the frontend on purpose, to open Checkout). RAZORPAY_KEY_SECRET must
# stay server-side only — it is used to create orders and verify
# payment signatures in /api/create-order.js and /api/verify-payment.js.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Webhook signing secret — set when you add the webhook endpoint in
# Dashboard → Settings → Webhooks (point it at https://yourdomain.com/api/webhook,
# subscribed to at least "payment.captured" and "payment.failed").
# Used only in /api/webhook.js to confirm a request really came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: restrict the API endpoints to a single origin once the site
# has a fixed production URL, e.g. https://texacoderzz.com
# Defaults to "*" (any origin) if unset. For /api/auth/*, this also
# controls cookie behavior — see SESSION_SECRET below.
ALLOWED_ORIGIN=*

# ---------------------------------------------------------------------
# Account system (Login / Sign Up) — see db/schema.sql and README.md
# ---------------------------------------------------------------------

# Postgres connection string (DATABASE_URL also works, if that's the name
# your provider gives you). If you provision a Postgres database from the
# Vercel dashboard (Storage → Create Database) and link it to this
# project, this is injected automatically and you don't need to set it
# yourself. For any other Postgres host (Neon directly, Supabase's own
# Postgres, Railway, etc.), paste its connection string here.
POSTGRES_URL=postgres://user:password@host:5432/dbname

# Random secret used to sign session cookies (jsonwebtoken). Generate one
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required — /api/auth/* returns 500 without it. Changing this value
# instantly logs every signed-in user out (all existing session cookies
# stop verifying).
SESSION_SECRET=replace_with_a_long_random_value

# Resend (https://resend.com) API key + a "from" address on a domain
# you've verified with Resend — used to send password-reset emails.
# Optional: if unset, forgot-password requests still succeed (so the
# response can't be used to check whether an email has an account) but no
# email actually goes out — check the Vercel function logs.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Texacoderzz <noreply@yourdomain.com>"

# Optional: the site's public URL, used to build the link inside
# password-reset emails (e.g. https://texacoderzz.com/reset-password.html).
# If unset, it's inferred from the incoming request's Host header, which
# is normally fine — set this explicitly only if that inference could be
# wrong for your setup (e.g. behind a proxy that doesn't forward it).
PUBLIC_SITE_URL=https://texacoderzz.com
