# Copy this file to .env for local development (vercel dev will load it).
# NEVER commit the real .env file — it is already listed in .gitignore.
# In production, set these as encrypted Environment Variables in your
# hosting provider's dashboard (Vercel: Project → Settings → Environment
# Variables), not in any file that gets committed.

# Razorpay API keys — Dashboard → Settings → API Keys
# https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID is safe to expose to the browser (the API returns it to
# the frontend on purpose, to open Checkout). RAZORPAY_KEY_SECRET must
# stay server-side only — it is used to create orders and verify
# payment signatures in /api/create-order.js and /api/verify-payment.js.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Webhook signing secret — set when you add the webhook endpoint in
# Dashboard → Settings → Webhooks (point it at https://yourdomain.com/api/webhook,
# subscribed to at least "payment.captured" and "payment.failed").
# Used only in /api/webhook.js to confirm a request really came from Razorpay.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: restrict the API endpoints to a single origin once the site
# has a fixed production URL, e.g. https://texacoderzz.com
# Defaults to "*" (any origin) if unset.
ALLOWED_ORIGIN=*
